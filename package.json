{
  "name": "poker-server",
  "version": "0.1.0",
  "description": "Real-time WebSocket game server for the Poker PWA.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:nodb": "cross-env DEV_NO_DB=1 tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo/cliClient.ts",
    "dev:p1": "tsx src/demo/cliClient.ts --dev-as p1",
    "dev:p2": "tsx src/demo/cliClient.ts --dev-as p2",
    "mint-jwt": "tsx scripts/mintTestJwt.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "poker-engine": "file:../poker-engine",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "cross-env": "^7.0.3",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
